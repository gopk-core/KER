#!/usr/bin/env python3
import sys
from pathlib import Path
# installed layout: /usr/lib/ker  ;  source tree: <repo>/python
for cand in (Path('/usr/lib/ker'), Path(__file__).resolve().parents[1] / 'python'):
    if (cand / 'ker' / '__init__.py').exists():
        sys.path.insert(0, str(cand))
        break
from ker.cli import main
raise SystemExit(main())
