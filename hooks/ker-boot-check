#!/usr/bin/env python3
import sys
from pathlib import Path
for cand in (
    Path('/usr/lib/ker'),
    Path(__file__).resolve().parent,
    Path(__file__).resolve().parents[1] / 'python',
):
    if (cand / 'ker' / '__init__.py').exists():
        sys.path.insert(0, str(cand))
        break

from ker.hooks import authorize, decision_json, log_decision

def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    scan = '--no-scan' not in argv
    if '--no-scan' in argv:
        argv.remove('--no-scan')
    quiet = False
    if '--quiet' in argv:
        quiet = True
        argv.remove('--quiet')
    decision = authorize('boot', scan=scan)
    log_decision(decision, tag='ker-boot')
    if not quiet:
        sys.stdout.write(decision_json(decision))
    if decision.get('block'):
        return 2
    return 0

if __name__ == '__main__':
    raise SystemExit(main())
