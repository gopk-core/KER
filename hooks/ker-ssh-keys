#!/usr/bin/env python3
import sys
from pathlib import Path
for cand in (
    Path('/usr/lib/ker'),
    Path(__file__).resolve().parent,
    Path(__file__).resolve().parents[1] / 'python',
):
    if (cand / 'ker' / '__init__.py').exists():
        sys.path.insert(0, str(cand))
        break

"""sshd AuthorizedKeysCommand. Prints keys when SSH is allowed; otherwise empty."""
from ker.hooks import authorize, log_decision, user_authorized_keys

def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    username = argv[0] if argv else ''
    decision = authorize('ssh', scan=True)
    decision['ssh_user'] = username
    log_decision(decision, tag='ker-ssh-keys')
    if decision.get('block'):
        return 1
    sys.stdout.write(user_authorized_keys(username))
    return 0

if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except SystemExit:
        raise
    except Exception as e:
        print(f'ker-ssh-keys internal error: {e}', file=sys.stderr)
        # Do not print keys on unexpected failure in enforce; handled in authorize.
        raise SystemExit(1)
