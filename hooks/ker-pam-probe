#!/usr/bin/env python3
import sys
from pathlib import Path
for cand in (
    Path('/usr/lib/ker'),
    Path(__file__).resolve().parent,
    Path(__file__).resolve().parents[1] / 'python',
):
    if (cand / 'ker' / '__init__.py').exists():
        sys.path.insert(0, str(cand))
        break

"""Minimal PAM conversation helper used by tests (password + account path)."""
import argparse
import ctypes
import ctypes.util

class PamHandle(ctypes.Structure):
    _fields_ = [('handle', ctypes.c_void_p)]

class PamMessage(ctypes.Structure):
    _fields_ = [('msg_style', ctypes.c_int), ('msg', ctypes.c_char_p)]

class PamResponse(ctypes.Structure):
    _fields_ = [('resp', ctypes.c_char_p), ('resp_retcode', ctypes.c_int)]

class PamConv(ctypes.Structure):
    _fields_ = [('conv', ctypes.c_void_p), ('appdata_ptr', ctypes.c_void_p)]

PAM_SUCCESS = 0
PAM_PROMPT_ECHO_OFF = 1
PAM_PROMPT_ECHO_ON = 2
PAM_ERROR_MSG = 3
PAM_TEXT_INFO = 4

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument('--service', default='sshd')
    ap.add_argument('--user', default='root')
    ap.add_argument('--password', default='')
    ap.add_argument('--account-only', action='store_true')
    args = ap.parse_args()
    libname = ctypes.util.find_library('pam') or 'libpam.so.0'
    pam = ctypes.CDLL(libname)
    libc = ctypes.CDLL(ctypes.util.find_library('c') or 'libc.so.6')

    CONVFUNC = ctypes.CFUNCTYPE(
        ctypes.c_int,
        ctypes.c_int,
        ctypes.POINTER(ctypes.POINTER(PamMessage)),
        ctypes.POINTER(ctypes.POINTER(PamResponse)),
        ctypes.c_void_p,
    )

    def conv_cb(num_msg, msg, resp, appdata):
        try:
            arr = (PamResponse * num_msg)()
            for i in range(num_msg):
                style = msg[i].contents.msg_style
                if style in (PAM_PROMPT_ECHO_OFF, PAM_PROMPT_ECHO_ON):
                    buf = libc.strdup(args.password.encode() if args.password else b'')
                    arr[i].resp = buf
                    arr[i].resp_retcode = 0
                else:
                    arr[i].resp = None
                    arr[i].resp_retcode = 0
            resp[0] = ctypes.cast(arr, ctypes.POINTER(PamResponse))
            # leak arr to pam (it frees with libc free) — allocate via malloc
            size = ctypes.sizeof(PamResponse) * num_msg
            raw = libc.malloc(size)
            ctypes.memmove(raw, ctypes.addressof(arr), size)
            resp[0] = ctypes.cast(raw, ctypes.POINTER(PamResponse))
            return PAM_SUCCESS
        except Exception:
            return 16  # PAM_CONV_ERR

    conv = PamConv(ctypes.cast(CONVFUNC(conv_cb), ctypes.c_void_p), None)
    handle = PamHandle()
    pam.pam_start.restype = ctypes.c_int
    rc = pam.pam_start(args.service.encode(), args.user.encode(), ctypes.byref(conv), ctypes.byref(handle))
    if rc != PAM_SUCCESS:
        print(f'pam_start={rc}')
        return 1
    if not args.account_only:
        rc = pam.pam_authenticate(handle, 0)
        print(f'pam_authenticate={rc}')
        if rc != PAM_SUCCESS:
            pam.pam_end(handle, rc)
            return 2
    rc = pam.pam_acct_mgmt(handle, 0)
    print(f'pam_acct_mgmt={rc}')
    pam.pam_end(handle, rc)
    return 0 if rc == PAM_SUCCESS else 3

if __name__ == '__main__':
    raise SystemExit(main())
